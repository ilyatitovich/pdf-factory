{
  "name": "pdf-factory",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@12.8.1+sha512.f64ba907507f5ceafe06c8d38e6052d0179444580ec1279ddd5bfc11cb48aa8a2644b66598e07e761da84872a9fc57d5f902b87fa49d024198d558612aabbe45",
  "scripts": {
    "dev": "vite",
    "build:wasm": "cp \"$(go env GOROOT)/lib/wasm/wasm_exec.js\" public/wasm_exec.js && GOOS=js GOARCH=wasm go -C wasm build -ldflags=\"-s -w\" -o ../public/pdf.wasm .",
    "prebuild": "pnpm build:wasm",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.app.json && tsc -p tsconfig.node.json"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@tsconfig/svelte": "^5.0.8",
    "@types/node": "^24.13.3",
    "svelte": "^5.56.10",
    "svelte-check": "^4.7.6",
    "typescript": "~6.0.2",
    "vite": "^8.2.2"
  },
  "dependencies": {
    "@tanstack/svelte-virtual": "^3.13.36",
    "fflate": "^0.8.3",
    "nanostores": "^1.0.1",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.3.289"
  }
}
